# ── Browserbase (optional) ──────────────────────────────────────────────
# When set, `pnpm agent:browserbase` runs the browser session on Browserbase.
# Without them, everything runs against a local headless Chromium.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: persistent Browserbase context id for session/auth reuse across runs.
BROWSERBASE_CONTEXT_ID=

# ── Model provider for Stagehand (one required for Stagehand paths only) ─
# Stagehand's observe/act/extract are LLM-driven. The Playwright baseline,
# the local lab, the model, and the dashboard all run without any key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional override, e.g. "anthropic/claude-haiku-4-5" or "openai/gpt-4.1-mini".
STAGEHAND_MODEL=

# ── Local flaky lab ──────────────────────────────────────────────────────
LAB_PORT=4517
LAB_SEED=42
# Demo credentials the lab accepts and the agent uses to log in.
# They gate fake seeded data only — never put real credentials in this file.
LAB_USERNAME=analyst
LAB_PASSWORD=scout-the-lab

# ── Dashboard ────────────────────────────────────────────────────────────
DASHBOARD_PORT=4618
