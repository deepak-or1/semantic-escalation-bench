{
  "name": "stateful-sports-data-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-native sports analytics and reliability evaluation built on Stagehand + Browserbase. Read-only analytics demo — no automated wagering.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "concurrently -n lab,dashboard -c blue,magenta \"tsx watch apps/lab/src/server.ts\" \"tsx watch apps/dashboard/src/server.ts\"",
    "dev:lab": "tsx watch apps/lab/src/server.ts",
    "dev:dashboard": "tsx watch apps/dashboard/src/server.ts",
    "seed": "tsx scripts/seed-lab.ts",
    "agent:local": "tsx scripts/run-agent.ts --env local",
    "agent:browserbase": "tsx scripts/run-agent.ts --env browserbase",
    "bench": "tsx scripts/run-benchmark.ts",
    "heals:collect": "tsx scripts/collect-heals.ts",
    "campaign:aggregate": "tsx scripts/aggregate-campaign.ts",
    "verify:suite": "tsx scripts/verify-suite.ts",
    "report": "tsx scripts/generate-report.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ssda/agent": "workspace:*",
    "@ssda/dashboard": "workspace:*",
    "@ssda/lab": "workspace:*",
    "@ssda/model": "workspace:*",
    "@ssda/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.14.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
