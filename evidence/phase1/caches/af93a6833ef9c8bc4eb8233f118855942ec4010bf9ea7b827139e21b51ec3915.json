{
  "consent": {
    "selector": "#accept-cookies",
    "description": "accept the cookie consent",
    "method": "click",
    "arguments": []
  },
  "username": {
    "selector": "xpath=/html[1]/body[1]/div[1]/main[1]/div[1]/section[1]/form[1]/label[1]/input[1]",
    "description": "type the username into the login form",
    "method": "fill",
    "arguments": [
      "%username%"
    ]
  },
  "password": {
    "selector": "xpath=/html[1]/body[1]/div[1]/main[1]/div[1]/section[1]/form[1]/label[2]/input[1]",
    "description": "type the password into the login form",
    "method": "fill",
    "arguments": [
      "%password%"
    ]
  },
  "login-submit": {
    "selector": "xpath=/html[1]/body[1]/div[1]/main[1]/div[1]/section[1]/form[1]/button[1]",
    "description": "submit the login form",
    "method": "click",
    "arguments": []
  },
  "dismiss-modal": {
    "selector": "#modal-close",
    "description": "close the popup dialog",
    "method": "click",
    "arguments": []
  },
  "reveal-table": {
    "selector": "#tab-table",
    "description": "reveal the full season standings table",
    "method": "click",
    "arguments": []
  },
  "next-page": {
    "selector": "#next-page",
    "description": "go to the next page of the standings table",
    "method": "click",
    "arguments": []
  }
}
